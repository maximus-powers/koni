    {"id": "S05-approve", "op": "run.approve_plan", "args": {"candidate": "current"}},
    {"id": "S06-capture", "op": "capture.collect", "args": {"checkpoint": "C01-approved", "surfaces": ["questions", "plans", "run_state", "sessions", "usage"]}}
