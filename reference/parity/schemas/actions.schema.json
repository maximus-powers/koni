{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koni.dev/parity/actions.schema.json",
  "title": "Koni parity action script",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "case_id", "isolation", "actions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol": { "const": "koni.parity-actions.v1" },
    "case_id": { "$ref": "case.schema.json#/$defs/case_id" },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporary_project", "temporary_pi_home", "network", "live_projects"],
      "properties": {
        "temporary_project": { "const": true },
        "temporary_pi_home": { "const": true },
        "network": { "enum": ["disabled", "fixture_only"] },
        "live_projects": { "const": false }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "op", "args"],
        "properties": {
          "id": { "$ref": "#/$defs/action_id" },
          "op": { "$ref": "#/$defs/operation" },
          "args": { "type": "object" },
          "expect_error": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "action_id": { "type": "string", "pattern": "^S[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "operation": {
      "enum": [
        "project.create", "project.install_profile", "project.upgrade_profile", "config.write_overlay",
        "git.create_branch", "git.checkout_branch", "git.inject_conflict",
        "run.create", "run.answer_question", "run.approve_plan", "run.revise_plan", "run.pause", "run.resume", "run.delete", "run.merge",
        "authority.tick", "authority.crash", "authority.restart",
        "agent.complete", "agent.fail", "agent.steer",
        "broker.call", "broker.replay",
        "ticket.submit", "ticket.review", "ticket.close",
        "compiler.compile", "compiler.reconcile",
        "session.emit", "session.compact", "session.restart",
        "tui.resize", "tui.focus", "tui.input",
        "capture.collect"
      ]
    }
  }
}
