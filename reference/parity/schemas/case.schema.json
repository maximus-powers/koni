{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koni.dev/parity/case.schema.json",
  "title": "Koni parity case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "id",
    "revision",
    "title",
    "domain",
    "tier",
    "summary",
    "drivers",
    "fixture",
    "action_script",
    "checkpoints",
    "assertions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol": { "const": "koni.parity-case.v1" },
    "id": { "$ref": "#/$defs/case_id" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "$ref": "#/$defs/case_id" },
    "title": { "type": "string", "minLength": 1 },
    "domain": {
      "enum": ["config", "run", "planning", "scheduler", "broker", "ticket", "git", "lifecycle", "recovery", "session", "tui", "software", "research"]
    },
    "tier": { "enum": ["P0", "P1", "P2"] },
    "summary": { "type": "string", "minLength": 1 },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["rust-oracle", "typescript-target"] }
    },
    "fixture": { "type": "string", "minLength": 1 },
    "action_script": { "type": "string", "minLength": 1 },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "after_action", "capture", "assertions"],
        "properties": {
          "id": { "$ref": "#/$defs/checkpoint_id" },
          "after_action": { "$ref": "actions.schema.json#/$defs/action_id" },
          "capture": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "capture.schema.json#/$defs/surface" }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/assertion_id" }
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "checkpoint", "surface", "comparator", "authority", "disposition", "description", "expected"],
        "properties": {
          "id": { "$ref": "#/$defs/assertion_id" },
          "checkpoint": { "$ref": "#/$defs/checkpoint_id" },
          "surface": { "$ref": "capture.schema.json#/$defs/surface" },
          "comparator": { "enum": ["structural", "semantic", "exact_bytes", "git_topology", "tui_semantics", "invariant", "budget", "security"] },
          "authority": { "enum": ["oracle", "specification"] },
          "disposition": { "enum": ["none", "oracle_defect", "superseded", "legacy_reader", "oracle_gap", "platform_variant", "quarantine"] },
          "issue_ref": { "$ref": "issues.schema.json#/$defs/issue_id" },
          "description": { "type": "string", "minLength": 1 },
          "expected": { "type": ["object", "array", "string", "number", "boolean", "null"] }
        }
      }
    }
  },
  "$defs": {
    "case_id": { "type": "string", "pattern": "^KPAR-[A-Z]{3,4}-[0-9]{4}$" },
    "checkpoint_id": { "type": "string", "pattern": "^C[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "assertion_id": { "type": "string", "pattern": "^A[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
