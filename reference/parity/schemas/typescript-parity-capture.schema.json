{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koni.dev/parity/typescript-parity-capture.schema.json",
  "title": "Normalized TypeScript assertion execution capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "oracle", "normalization", "isolation", "cases", "capture_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "koni.typescript-parity-capture.v1"},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "semantic_suite_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "semantic_suite_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "normalization": {"const": "koni.parity-normalization.v2"},
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporary_projects", "temporary_pi_homes", "live_projects", "provider_calls"],
      "properties": {
        "temporary_projects": {"const": true},
        "temporary_pi_homes": {"const": true},
        "live_projects": {"const": false},
        "provider_calls": {"const": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "outcome", "assertions"],
        "properties": {
          "id": {"$ref": "case.schema.json#/$defs/case_id"},
          "outcome": {"enum": ["passing", "failed", "blocked"]},
          "assertions": {"type": "array", "minItems": 1}
        }
      }
    },
    "capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
