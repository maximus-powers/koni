{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koni.dev/parity/proofs.schema.json",
  "title": "Koni assertion-level executable proof manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "principle", "proofs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "koni.parity-proofs.v1"},
    "principle": {"type": "string", "minLength": 1},
    "proofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "assertion_id", "checkpoint", "contract_sha256", "comparison", "target_tests"],
        "properties": {
          "case_id": {"$ref": "case.schema.json#/$defs/case_id"},
          "assertion_id": {"$ref": "case.schema.json#/$defs/assertion_id"},
          "checkpoint": {"$ref": "case.schema.json#/$defs/checkpoint_id"},
          "contract_sha256": {"oneOf": [{"const": "derived"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
          "comparison": {"enum": ["semantic-oracle-contract", "semantic-specification-contract"]},
          "target_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "title"],
              "properties": {"file": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}}
            }
          },
          "oracle_test": {"type": "string", "minLength": 1},
          "oracle_capture_command": {"type": "string", "minLength": 1},
          "blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "required_surface", "acceptance"],
            "properties": {
              "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "required_surface": {"type": "string", "minLength": 1},
              "acceptance": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
