{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koni.dev/parity/capture.schema.json",
  "title": "Koni normalized parity capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "case_id", "driver", "checkpoint", "oracle", "artifacts", "process", "secret_scan"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "protocol": { "const": "koni.parity-capture.v1" },
    "case_id": { "$ref": "case.schema.json#/$defs/case_id" },
    "driver": { "enum": ["rust-oracle", "typescript-target"] },
    "checkpoint": { "$ref": "case.schema.json#/$defs/checkpoint_id" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "fingerprint_sha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "path", "sha256", "bytes", "normalization_sha256"],
        "properties": {
          "surface": { "$ref": "#/$defs/surface" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "normalization_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stdout_sha256", "stderr_sha256", "timed_out", "descendants_alive"],
      "properties": {
        "exit_code": { "type": "integer" },
        "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "timed_out": { "type": "boolean" },
        "descendants_alive": { "type": "integer", "minimum": 0 }
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "matches"],
      "properties": {
        "passed": { "type": "boolean" },
        "matches": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "surface": {
      "enum": [
        "profile", "config", "graph", "tickets", "run_state", "events", "questions", "plans", "agents", "grants", "receipts", "journal", "git", "worktrees", "sessions", "usage", "tui", "filesystem", "processes", "reports"
      ]
    }
  }
}
