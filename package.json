{
  "name": "koni",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Koni's Pi-native compiler-authoritative agent harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximus-powers/koni.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:brand": "./scripts/check-brand.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:shell": "bash -n scripts/*.sh",
    "test:architecture": "node --test scripts/architecture-budget.test.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:profiles test:turborepo",
    "test:docs": "node --test scripts/docs-links.test.mjs",
    "test:profiles": "node --test scripts/profile-bundles.test.mjs",
    "test:pi-host-boundary": "node --test scripts/pi-host-boundary.test.mjs",
    "test:pi-package": "node --test scripts/pi-package-smoke.test.mjs",
    "test:turborepo": "node --test scripts/turborepo-migration.test.mjs",
    "test:repository-gates": "node --test scripts/check-brand.test.mjs scripts/pi-git-package-resolution.test.mjs scripts/pi-git-production-pin.test.mjs scripts/provider-free-environment.test.mjs scripts/release-workflow.test.mjs scripts/clean-package-build.test.mjs",
    "check": "pnpm run lint && pnpm run lint:shell && pnpm run format:check && turbo run test:repository-gates check:brand test:docs test:architecture test:profiles test:pi-host-boundary test:turborepo build typecheck test test:pi-package",
    "profiles:capture": "node scripts/capture-profile-bundles.mjs --publish-current"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "@types/semver": "7.7.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "turbo": "2.10.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.13.1"
}
