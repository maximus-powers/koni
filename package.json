{
  "name": "koni",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Koni's Pi-native compiler-authoritative agent harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximus-powers/koni.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check:brand": "./scripts/check-brand.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:shell": "bash -n scripts/*.sh",
    "test:architecture": "node --test scripts/architecture-budget.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:profiles && npm run test --workspaces --if-present && npm run test:pi-package",
    "test:docs": "node --test scripts/docs-links.test.mjs",
    "test:profiles": "node --test scripts/profile-bundles.test.mjs",
    "test:pi-host-boundary": "node --test scripts/pi-host-boundary.test.mjs",
    "test:pi-package": "npm run build --workspace @koni/core && node --test scripts/pi-package-smoke.test.mjs",
    "check": "npm run lint && npm run lint:shell && npm run format:check && node --test scripts/check-brand.test.mjs scripts/pi-git-package-resolution.test.mjs scripts/pi-git-production-pin.test.mjs scripts/provider-free-environment.test.mjs scripts/release-workflow.test.mjs && npm run check:brand && npm run test:docs && npm run test:architecture && npm run test:profiles && npm run test:pi-host-boundary && node --test scripts/clean-package-build.test.mjs && npm run check --workspaces --if-present && node --test scripts/pi-package-smoke.test.mjs",
    "profiles:capture": "node scripts/capture-profile-bundles.mjs --publish-current"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "@types/semver": "7.7.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@11.13.0"
}
