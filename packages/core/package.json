{
  "name": "@koni/core",
  "version": "1.0.0",
  "description": "Compiler-authoritative Koni runtime and control center for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximus-powers/koni.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/maximus-powers/koni#readme",
  "bugs": "https://github.com/maximus-powers/koni/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "koni": "./bin/koni.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "agent-harness",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./dist/skills"
    ]
  },
  "koni": {
    "kind": "core",
    "core_api_version": "1.0.0",
    "authority_protocol": "koni.authority.v1",
    "profile_package_protocol": "koni.profile-package.v1",
    "profile_schema_range": ">=3.0.0 <4.0.0",
    "pi_range": "0.80.10"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-build.mjs . && tsc -p tsconfig.build.json && node ../../scripts/copy-core-skills.mjs && node ../../scripts/embed-core-build-identity.mjs",
    "postinstall": "node ./bin/koni-package-lifecycle.js activate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:parallel && pnpm run test:exclusive",
    "test:parallel": "vitest run --config vitest.parallel.config.ts",
    "test:exclusive": "vitest run --config vitest.exclusive.config.ts",
    "test:file": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
