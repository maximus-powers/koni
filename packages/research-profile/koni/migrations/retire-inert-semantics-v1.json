{
  "protocol": "koni.profile-retirement.v1",
  "id": "retire-inert-semantics-v1",
  "operations": [
    {
      "file": "actions/research.yaml",
      "selectors": [
        {
          "array_pointer": "/actions",
          "key": "id",
          "equals": "compile-full"
        },
        {
          "array_pointer": "/recipe",
